# The Wise Parent — server environment
# Postgres connection string (Vercel Postgres, Neon, Supabase, Netlify DB, etc. all work).
DATABASE_URL=postgres://user:password@host:5432/dbname

# Live AI Coach — either key enables it, both stay server-only (end users never see them).
# Gemini has a free tier (aistudio.google.com/apikey) and is tried first if both are set.
GEMINI_API_KEY=...
ANTHROPIC_API_KEY=sk-ant-...

# "Continue with Google" sign-in. Optional — the app works fine without it,
# the button just doesn't render. This is a Client ID only (no secret needed,
# it's the ID-token flow): Google Cloud Console → APIs & Services →
# Credentials → Create OAuth client ID → Web application → add your site's
# origin (e.g. https://your-app.netlify.app and http://localhost:3000) under
# "Authorized JavaScript origins". Must start with NEXT_PUBLIC_ so the
# client-side button can read it — a Client ID is not a secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com

# Stripe (real card payments). All four optional together — without them,
# Pricing's "Pay with card" falls back to an instant demo activation.
# Price IDs come from Stripe Dashboard → Product catalog (one recurring
# price per plan). Point a Stripe webhook at /api/webhooks/stripe for the
# events: customer.subscription.created / .updated / .deleted.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# /admin dashboard — confirms manual PayPal/Zalo payments (see README →
# Payments). The PayPal.me link and Zalo QR itself need no env config; they
# live in lib/manualPayment.js.
ADMIN_SECRET=choose-a-long-random-password
ADMIN_EMAIL=you@example.com

# Optional: email ping to ADMIN_EMAIL when someone submits a manual payment
# request, and to relay Contact/Support messages and cancellation notices.
# Free tier at resend.com. Without this, payment requests still appear in
# /admin, you just won't get notified, and the Contact form falls back to
# a mailto: link instead of sending.
RESEND_API_KEY=re_...

# PayPal Subscriptions (real, auto-activating recurring payments). All five
# optional together — without them, Pricing's PayPal step falls back to the
# existing manual PayPal.me + Zalo flow (no behavior change). Needs a PayPal
# BUSINESS account — Subscriptions aren't available to personal accounts.
#
# Setup (one time, in the PayPal dashboard):
#   1. developer.paypal.com → Apps & Credentials → Create App (Live, not
#      Sandbox, once you're ready to accept real payments). Copy the
#      "Client ID" → NEXT_PUBLIC_PAYPAL_CLIENT_ID and "Secret" →
#      PAYPAL_CLIENT_SECRET.
#   2. paypal.com Business account → Pay & Get Paid → Subscriptions (or
#      developer.paypal.com → Subscriptions) → create a Product, then two
#      Subscription Plans under it — one monthly ($9.99), one yearly
#      ($79.99). Copy each Plan ID → NEXT_PUBLIC_PAYPAL_PLAN_MONTHLY /
#      NEXT_PUBLIC_PAYPAL_PLAN_YEARLY.
#   3. developer.paypal.com → Apps & Credentials → (your app) → Webhooks →
#      Add Webhook. URL: https://your-app.netlify.app/api/webhooks/paypal.
#      Subscribe to these events only: BILLING.SUBSCRIPTION.ACTIVATED,
#      BILLING.SUBSCRIPTION.CANCELLED, BILLING.SUBSCRIPTION.EXPIRED,
#      BILLING.SUBSCRIPTION.SUSPENDED. Copy the Webhook ID → PAYPAL_WEBHOOK_ID.
#
# Recommended: test the whole flow once with a Sandbox app/plans/webhook
# first (set PAYPAL_ENV=sandbox), then switch all five values to your Live
# app before going live for real customers.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
PAYPAL_WEBHOOK_ID=...
NEXT_PUBLIC_PAYPAL_PLAN_MONTHLY=P-...
NEXT_PUBLIC_PAYPAL_PLAN_YEARLY=P-...
# PAYPAL_ENV=sandbox
