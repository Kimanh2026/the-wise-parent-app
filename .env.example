# The Wise Parent — server environment
# Postgres connection string (Vercel Postgres, Neon, Supabase, Netlify DB, etc. all work).
DATABASE_URL=postgres://user:password@host:5432/dbname

# The application's Anthropic API key lives ONLY on the server.
# End users never see or enter this key.
ANTHROPIC_API_KEY=sk-ant-...
